# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── SQLite databases (never commit live data) ─────────────────────────────────
*.db
*.sqlite
*.sqlite3
# Keep instance/ folder tracked but ignore any database files inside it
instance/*.db
instance/*.sqlite
instance/*.sqlite3

# ── Environment variables (may contain secrets) ───────────────────────────────
.env
.env.*

# ── pytest cache ──────────────────────────────────────────────────────────────
.pytest_cache/
.cache/

# ── Coverage reports ──────────────────────────────────────────────────────────
htmlcov/
.coverage
coverage.xml

# ── Distribution / packaging ──────────────────────────────────────────────────
dist/
build/
*.egg-info/

# ── Editor / IDE files ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
